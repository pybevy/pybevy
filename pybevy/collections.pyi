from collections.abc import Callable, Iterable, Iterator, Sequence
from typing import Protocol, Self, overload, runtime_checkable

from _typeshed import SupportsRichComparison

@runtime_checkable
class LiveSequence[T_co](Protocol):
    """Read-only indexed access into live engine-owned storage.

    Supports the read-only `list` operations: slicing and `+` return new plain
    lists, and every live sequence is a registered `collections.abc.Sequence`.
    """

    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> T_co: ...
    @overload
    def __getitem__(self, index: slice) -> list[T_co]: ...
    def __iter__(self) -> Iterator[T_co]: ...
    def __reversed__(self) -> Iterator[T_co]: ...
    def index(self, value: object, start: int = 0, stop: int = ...) -> int: ...
    def count(self, value: object) -> int: ...
    def __add__[S](self, other: Sequence[S]) -> list[T_co | S]: ...
    def __radd__[S](self, other: Sequence[S]) -> list[T_co | S]: ...
    def __copy__(self) -> list[T_co]: ...
    def to_list(self) -> list[T_co]: ...

@runtime_checkable
class LiveArray[T](LiveSequence[T], Protocol):
    """Fixed-length mutable indexed access into live engine-owned storage."""

    def __setitem__(self, index: int, value: T) -> None: ...

@runtime_checkable
class LiveList[T](LiveSequence[T], Protocol):
    """Mutable indexed access into live engine-owned storage.

    A registered `collections.abc.MutableSequence`. `+=`, `remove`, `reverse`
    and `sort` edit the engine storage in place; `copy()` returns detached owned
    copies.
    """

    def __setitem__(self, index: int, value: T) -> None: ...
    def __delitem__(self, index: int) -> None: ...
    def __iadd__(self, values: Iterable[T]) -> Self: ...  # type: ignore[override, misc]
    def append(self, value: T) -> None: ...
    def extend(self, values: Iterable[T]) -> None: ...
    def insert(self, index: int, value: T) -> None: ...
    def pop(self, index: int = -1) -> T: ...
    def remove(self, value: object) -> None: ...
    def reverse(self) -> None: ...
    def sort(
        self, *, key: Callable[[T], SupportsRichComparison] | None = None, reverse: bool = False
    ) -> None: ...
    def copy(self) -> list[T]: ...
    def clear(self) -> None: ...
