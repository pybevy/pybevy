"""Type stubs for lazy expression system."""

from typing import NoReturn, overload

from pybevy.ecs import Vec3Expr as _ViewVec3Expr
from pybevy.math import Mat2, Mat3, Mat4, Quat, Vec2, Vec3, Vec4

class Expr:
    """Base class for lazy expression tree nodes.

    Arithmetic follows NumPy element-wise semantics: `/` is float true
    division; `//` is floor division and pairs with `%` (divisor's sign).
    Zero divisors give inf/NaN for floats and 0 for integers, without warnings.
    An `int` literal takes the field's type and a `float` literal promotes an
    integer field to float64. Integer `**` wraps; a negative exponent raises
    `ValueError`. An int literal outside an integer field's range raises
    `OverflowError`.
    """

    op: str
    args: list[object]

    def __init__(self, op: str, args: list[object]) -> None: ...
    # Truth testing raises; use &, |, ~ and .where().
    def __bool__(self) -> NoReturn: ...

    # Binary operators
    def __add__(self, other: Expr | float | int) -> Expr: ...
    def __radd__(self, other: Expr | float | int) -> Expr: ...
    def __sub__(self, other: Expr | float | int) -> Expr: ...
    def __rsub__(self, other: Expr | float | int) -> Expr: ...
    @overload
    def __mul__(self, other: Expr | float | int) -> Expr: ...
    @overload
    def __mul__(self, other: Vec2Expr | Vec2Expression) -> Vec2Expression: ...
    @overload
    def __mul__(self, other: Vec4Expr | Vec4Expression) -> Vec4Expression: ...
    @overload
    def __mul__(self, other: Vec3Expr | Vec3Expression) -> Vec3Expression: ...
    @overload
    def __mul__(self, other: _ViewVec3Expr) -> _ViewVec3Expr: ...
    def __rmul__(self, other: Expr | float | int) -> Expr: ...
    def __truediv__(self, other: Expr | float | int) -> Expr: ...
    def __rtruediv__(self, other: Expr | float | int) -> Expr: ...
    def __floordiv__(self, other: Expr | float | int) -> Expr: ...
    def __rfloordiv__(self, other: Expr | float | int) -> Expr: ...
    def __ifloordiv__(self, other: Expr | float | int) -> Expr: ...
    def __pow__(self, other: Expr | float | int) -> Expr: ...
    def __rpow__(self, other: Expr | float | int) -> Expr: ...
    def __mod__(self, other: Expr | float | int) -> Expr: ...
    def __rmod__(self, other: Expr | float | int) -> Expr: ...

    # Unary operators
    def __neg__(self) -> Expr: ...

    # Comparison operators
    def __eq__(self, other: Expr | float | int) -> Expr: ...  # type: ignore[override]
    def __ne__(self, other: Expr | float | int) -> Expr: ...  # type: ignore[override]
    def __lt__(self, other: Expr | float | int) -> Expr: ...
    def __le__(self, other: Expr | float | int) -> Expr: ...
    def __gt__(self, other: Expr | float | int) -> Expr: ...
    def __ge__(self, other: Expr | float | int) -> Expr: ...

    # Logical operators
    def __and__(self, other: Expr | float | int) -> Expr: ...
    def __or__(self, other: Expr | float | int) -> Expr: ...
    def __invert__(self) -> Expr: ...

    # Math functions
    def sqrt(self) -> Expr: ...
    def abs(self) -> Expr: ...
    def min(self, other: Expr | float | int) -> Expr:
        """Element-wise minimum, propagating NaN."""
    def max(self, other: Expr | float | int) -> Expr:
        """Element-wise maximum, propagating NaN."""
    def clamp(
        self,
        min_val: Expr | float | int,
        max_val: Expr | float | int,
    ) -> Expr: ...

    # Trigonometric functions
    def sin(self) -> Expr: ...
    def cos(self) -> Expr: ...
    def tan(self) -> Expr: ...
    def asin(self) -> Expr: ...
    def acos(self) -> Expr: ...
    def atan(self) -> Expr: ...

    # Rounding functions
    def floor(self) -> Expr: ...
    def ceil(self) -> Expr: ...
    def round(self) -> Expr:
        """Round ties to even, unlike glam-backed Vec2/Vec3/Vec4.round()."""

    # Exponential and logarithmic functions
    def exp(self) -> Expr: ...
    def ln(self) -> Expr: ...
    def log10(self) -> Expr: ...
    def log2(self) -> Expr: ...

    # Additional math operations
    def sign(self) -> Expr: ...
    def fract(self) -> Expr:
        """Signed fraction x - trunc(x); negative inputs can return negative values."""
    def mod(self, other: Expr | float | int) -> Expr:
        """Python-style modulo; the nonzero result has the divisor's sign."""
    def lerp(
        self,
        other: Expr | float | int,
        t: Expr | float | int,
    ) -> Expr: ...

    # Random functions
    def random(self, *, stream: int = 0) -> Expr:
        """Stable per-entity draw; use distinct streams for independent draws."""
    def random_range(
        self,
        min: Expr | float | int,
        max: Expr | float | int,
        *,
        stream: int = 0,
    ) -> Expr:
        """Rescale the per-entity draw selected by stream into [min, max)."""

    # Conditional selection
    def where(
        self,
        true_value: Expr | float | int,
        false_value: Expr | float | int,
    ) -> Expr: ...

class FieldExpr(Expr):
    """Represents a scalar field in a View expression (e.g., intensity, range).

    Supports arithmetic operations, comparisons, and array-like indexing for Numba kernels.
    """

    component_id: int
    field_name: str
    offset: int
    field_type: str
    _parent_proxy: object | None

    def __init__(
        self, component_id: int, field_name: str, offset: int, field_type: str = "F32"
    ) -> None: ...

    def _set_parent(self, parent: object) -> None:
        """Internal: Set the parent proxy for assignment triggering."""

    # In-place operators (trigger immediate assignment)
    # Typed as FieldExpr so `column.x += 1` type-checks against the property getter.
    def __iadd__(self, other: Expr | float | int) -> FieldExpr: ...
    def __isub__(self, other: Expr | float | int) -> FieldExpr: ...
    @overload
    def __imul__(self, other: Expr | float | int) -> FieldExpr: ...
    @overload
    def __imul__(self, other: Vec2Expr | Vec2Expression) -> Vec2Expression: ...
    @overload
    def __imul__(self, other: Vec4Expr | Vec4Expression) -> Vec4Expression: ...
    @overload
    def __imul__(self, other: Vec3Expr | Vec3Expression) -> Vec3Expression: ...
    @overload
    def __imul__(self, other: _ViewVec3Expr) -> _ViewVec3Expr: ...
    def __itruediv__(
        self, other: Expr | float | int
    ) -> FieldExpr: ...
    def __ifloordiv__(self, other: Expr | float | int) -> FieldExpr: ...
    def __ipow__(self, other: Expr | float | int) -> FieldExpr: ...
    def __imod__(self, other: Expr | float | int) -> FieldExpr: ...

    # Assignment
    def set(self, value: Expr | float | int) -> None:
        """Assign a value or expression to this field."""


class Vec2Expression:
    x: Expr
    y: Expr
    def __init__(self, x_expr: Expr | float | int, y_expr: Expr | float | int) -> None: ...
    def __add__(self, other: Vec2Expression | Vec2Expr) -> Vec2Expression: ...
    def __sub__(self, other: Vec2Expression | Vec2Expr) -> Vec2Expression: ...
    def __mul__(self, scalar: Expr | float | int) -> Vec2Expression: ...
    def __rmul__(self, scalar: Expr | float | int) -> Vec2Expression: ...
    def __truediv__(self, scalar: Expr | float | int) -> Vec2Expression: ...
    def __repr__(self) -> str: ...

